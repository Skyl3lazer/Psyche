<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Cyanobot's Genes</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>/Defs</xpath>
      <value>

        <!-- Untreatable only when this pawn's copy of the trait came from a gene, checked at seed time. -->
        <HediffDef>
          <defName>Psyche_Scar_Unaffected</defName>
          <hediffClass>Psyche.Hediff_PsycheScar</hediffClass>
          <label>affect-blunting psyche scar</label>
          <description>A numbness to both insult and kindness worn into the mind. It is a lasting mark on the psyche, and only the most advanced therapy can lift it entirely - unless it was carried in the blood from birth, in which case no therapy ever will.</description>
          <isBad>true</isBad>
          <maxSeverity>1000</maxSeverity>
          <scenarioCanAdd>false</scenarioCanAdd>
          <modExtensions>
            <li Class="Psyche.PsycheHealthOffsetExtension">
              <maxHealthPerSeverity>-0.3</maxHealthPerSeverity>
            </li>
            <li Class="Psyche.PsycheTraitMarkExtension">
              <trait>CYB_Unaffected</trait>
              <degree>0</degree>
              <seedSeverity>8</seedSeverity>
            </li>
          </modExtensions>
          <comps>
            <li Class="Psyche.HediffCompProperties_PsycheOffset" />
          </comps>
        </HediffDef>

      </value>
    </match>
  </Operation>
</Patch>
