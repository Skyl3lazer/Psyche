<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Altered Carbon 2: ReSleeved</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAddModExtension">
          <xpath>/Defs/ThoughtDef[defName="AC_CharityRefused_Essential_IntroResearcher"]</xpath>
          <value>
            <li Class="Psyche.PsycheThoughtExtension"><scarDef>Psyche_Scar_Callousness</scarDef></li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>/Defs/ThoughtDef[defName="AC_ErasedStack"]</xpath>
          <value>
            <li Class="Psyche.PsycheThoughtExtension"><scarDef>Psyche_Scar_Bloodguilt</scarDef></li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>/Defs/ThoughtDef[defName="AC_StackDegradationThought" or defName="AC_JustCopy" or starts-with(defName, "AC_Wrong") or starts-with(defName, "VFEU_Wrong") or starts-with(defName, "AC_New") or starts-with(defName, "VFEU_New") or defName="AC_WantsShell" or defName="VFEU_WantsShell"]</xpath>
          <value>
            <li Class="Psyche.PsycheThoughtExtension"><scarDef>Psyche_Scar_Identity</scarDef></li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>/Defs/ThoughtDef[defName="AC_CharityFulfilled_Essential_IntroResearcher" or defName="AC_CharityFulfilled_Important_IntroResearcher" or defName="AC_CharityFulfilled_Worthwhile_IntroResearcher" or defName="AC_CharityFulfilled_Researcher"]</xpath>
          <value>
            <li Class="Psyche.PsycheThoughtExtension"><closesScar>Psyche_Scar_Callousness</closesScar></li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
