          </comps>
          <stages>
            <li>
              <minSeverity>0</minSeverity>
              <label>wary</label>
            </li>
            <li>
              <minSeverity>3</minSeverity>
            </li>
            <li>
              <minSeverity>6</minSeverity>
              <label>compulsive</label>
            </li>
          </stages>
        </HediffDef>

        <HediffDef>
