<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Anomaly Expanded - Insanity</li>
    </mods>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/ThoughtDef[defName="VAEI_MockedMood" or defName="VAEI_VileSlanderMood"]</xpath>
      <value>
        <li Class="Psyche.PsycheThoughtExtension"><exemptFromWounds>true</exemptFromWounds></li>
      </value>
    </match>
  </Operation>

  <!-- Too total a corruption for any therapy to undo. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Anomaly Expanded - Insanity</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>/Defs</xpath>
      <value>

        <HediffDef>
          <defName>Psyche_Scar_Inhumanized</defName>
          <hediffClass>Psyche.Hediff_PsycheScar</hediffClass>
          <label>inhumanized psyche scar</label>
          <description>A disconnection from human bonds worn permanently into the mind. It is total enough that no therapy, however advanced, can ever undo it.</description>
          <isBad>true</isBad>
          <maxSeverity>1000</maxSeverity>
          <scenarioCanAdd>false</scenarioCanAdd>
          <modExtensions>
            <li Class="Psyche.PsycheHealthOffsetExtension">
              <maxHealthPerSeverity>-0.3</maxHealthPerSeverity>
            </li>
            <li Class="Psyche.PsycheTraitMarkExtension">
              <trait>VAEI_Inhumanized</trait>
              <degree>0</degree>
              <seedSeverity>8</seedSeverity>
            </li>
            <li Class="Psyche.PsycheScarExtension">
              <alwaysUntreatable>true</alwaysUntreatable>
            </li>
          </modExtensions>
          <comps>
            <li Class="Psyche.HediffCompProperties_PsycheOffset" />
          </comps>
          <stages>
            <li>
              <minSeverity>0</minSeverity>
              <label>distant</label>
            </li>
            <li>
              <minSeverity>3</minSeverity>
            </li>
            <li>
              <minSeverity>6</minSeverity>
              <label>severed</label>
            </li>
          </stages>
        </HediffDef>

        <HediffDef>
          <defName>Psyche_Scar_VoidTouched</defName>
          <hediffClass>Psyche.Hediff_PsycheScar</hediffClass>
