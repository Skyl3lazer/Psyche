            </li>
            <li Class="Psyche.PsycheTraitMarkExtension">
              <trait>VAEI_Distractable</trait>
              <degree>0</degree>
              <seedSeverity>8</seedSeverity>
            </li>
          </modExtensions>
          <comps>
            <li Class="Psyche.HediffCompProperties_PsycheOffset" />
          </comps>
        </HediffDef>

      </value>
    </match>
  </Operation>
</Patch>
