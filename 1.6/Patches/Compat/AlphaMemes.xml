<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Alpha Memes</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAddModExtension">
          <xpath>/Defs/ThoughtDef[defName="AM_AteNutrientPasteMeal_Forbidden" or defName="AM_Meals_QualityDesired_AteRawFood" or defName="AM_CombatProwess_Melee_UsedRanged"]</xpath>
          <value>
            <li Class="Psyche.PsycheThoughtExtension"><scarDef>Psyche_Scar_Apostasy</scarDef></li>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>/Defs/ThoughtDef[defName="AM_RoughLiving_Disliked_AteWithoutATable" or defName="AM_SleptInBarracksMonastic" or defName="AM_SleptInBarracksPreferred" or defName="AM_Recreation_Abhorrent"]</xpath>
          <value>
            <li Class="Psyche.PsycheThoughtExtension"><exemptFromWounds>true</exemptFromWounds></li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
