<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Therapy (Continued)</li>
    </mods>
    <match Class="PatchOperationAddModExtension">
      <xpath>/Defs/ThoughtDef[defName="TherapyRelieved"]</xpath>
      <value>
        <li Class="Psyche.PsycheThoughtExtension"><exemptFromWounds>true</exemptFromWounds></li>
      </value>
    </match>
  </Operation>
</Patch>
