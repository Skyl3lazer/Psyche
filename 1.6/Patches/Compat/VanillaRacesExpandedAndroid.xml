<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Android drones have no psychology to wound. removeWhenAwakened drops both genes, restoring eligibility on awakening. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Races Expanded - Android</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/VREAndroids.AndroidGeneDef[defName="VREA_MentalBreaksDisabled" or defName="VREA_PsychologyDisabled"]</xpath>
      <value>
        <disablesNeeds>
          <li>Psyche_Core</li>
        </disablesNeeds>
      </value>
    </match>
  </Operation>
</Patch>
