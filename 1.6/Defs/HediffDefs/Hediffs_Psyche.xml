<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>Psyche_Scar</defName>
    <hediffClass>Psyche.Hediff_PsycheScar</hediffClass>
    <label>psyche scar</label>
    <description>A permanent mark left by trauma that never fully healed. It lowers the maximum psyche health this person can hold.</description>
    <isBad>true</isBad>
    <maxSeverity>1000</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <modExtensions>
      <li Class="Psyche.PsycheHealthOffsetExtension">
        <maxHealthPerSeverity>-1</maxHealthPerSeverity>
      </li>
    </modExtensions>
    <comps>
      <li Class="Psyche.HediffCompProperties_PsycheOffset" />
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>faint</label>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <label>deep</label>
      </li>
      <li>
        <minSeverity>6</minSeverity>
        <label>severe</label>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Psyche_Clarity</defName>
    <hediffClass>Psyche.Hediff_PsycheClarity</hediffClass>
    <label>psyche clarity</label>
    <description>A lasting insight won from a profound experience. It raises the maximum psyche health this person can hold, above their natural baseline.</description>
    <isBad>false</isBad>
    <maxSeverity>1000</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <modExtensions>
      <li Class="Psyche.PsycheHealthOffsetExtension">
        <maxHealthPerSeverity>1</maxHealthPerSeverity>
      </li>
    </modExtensions>
    <comps>
      <li Class="Psyche.HediffCompProperties_PsycheOffset" />
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>faint</label>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <label>notable</label>
      </li>
      <li>
        <minSeverity>6</minSeverity>
        <label>profound</label>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Psyche_Scar_Haunted</defName>
    <hediffClass>Psyche.Hediff_PsycheScar</hediffClass>
    <label>haunted psyche scar</label>
    <description>A wound that keeps its grip. The memory intrudes unbidden, dulling the drive to work and pulling this person away from others - and at its worst it sends them wandering, lost in it.</description>
    <isBad>true</isBad>
    <maxSeverity>1000</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <modExtensions>
      <li Class="Psyche.PsycheHealthOffsetExtension">
        <maxHealthPerSeverity>-1</maxHealthPerSeverity>
      </li>
    </modExtensions>
    <comps>
      <li Class="Psyche.HediffCompProperties_PsycheOffset" />
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>faint</label>
        <statOffsets>
          <SocialImpact>-0.15</SocialImpact>
        </statOffsets>
        <statFactors>
          <WorkSpeedGlobal>0.97</WorkSpeedGlobal>
        </statFactors>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <label>deep</label>
        <statOffsets>
          <SocialImpact>-0.30</SocialImpact>
        </statOffsets>
        <statFactors>
          <WorkSpeedGlobal>0.93</WorkSpeedGlobal>
        </statFactors>
        <mentalStateGivers>
          <li>
            <mentalState>Wander_Sad</mentalState>
            <mtbDays>30</mtbDays>
          </li>
        </mentalStateGivers>
      </li>
      <li>
        <minSeverity>6</minSeverity>
        <label>severe</label>
        <statOffsets>
          <SocialImpact>-0.50</SocialImpact>
        </statOffsets>
        <statFactors>
          <WorkSpeedGlobal>0.88</WorkSpeedGlobal>
        </statFactors>
        <mentalStateGivers>
          <li>
            <mentalState>Wander_Sad</mentalState>
            <mtbDays>15</mtbDays>
          </li>
        </mentalStateGivers>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Psyche_Clarity_HardWon</defName>
    <hediffClass>Psyche.Hediff_PsycheClarity</hediffClass>
    <label>hard-won psyche clarity</label>
    <description>An understanding paid for in pain and kept. Having sat with the worst and come through, this person learns faster and works with a steadier hand.</description>
    <isBad>false</isBad>
    <maxSeverity>1000</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <modExtensions>
      <li Class="Psyche.PsycheHealthOffsetExtension">
        <maxHealthPerSeverity>1</maxHealthPerSeverity>
      </li>
    </modExtensions>
    <comps>
      <li Class="Psyche.HediffCompProperties_PsycheOffset" />
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>faint</label>
        <statOffsets>
          <GlobalLearningFactor>0.05</GlobalLearningFactor>
        </statOffsets>
        <statFactors>
          <WorkSpeedGlobal>1.02</WorkSpeedGlobal>
        </statFactors>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <label>notable</label>
        <statOffsets>
          <GlobalLearningFactor>0.10</GlobalLearningFactor>
        </statOffsets>
        <statFactors>
          <WorkSpeedGlobal>1.04</WorkSpeedGlobal>
        </statFactors>
      </li>
      <li>
        <minSeverity>6</minSeverity>
        <label>profound</label>
        <statOffsets>
          <GlobalLearningFactor>0.15</GlobalLearningFactor>
        </statOffsets>
        <statFactors>
          <WorkSpeedGlobal>1.06</WorkSpeedGlobal>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Psyche_Scar_Pyromaniac</defName>
    <hediffClass>Psyche.Hediff_PsycheScar</hediffClass>
    <label>pyromania psyche scar</label>
    <description>A fixation on flame worn into the mind. It is a lasting mark on the psyche, and only the most advanced therapy can lift it entirely.</description>
    <isBad>true</isBad>
    <maxSeverity>1000</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <modExtensions>
      <li Class="Psyche.PsycheHealthOffsetExtension">
        <maxHealthPerSeverity>-0.3</maxHealthPerSeverity>
      </li>
      <li Class="Psyche.PsycheTraitMarkExtension">
        <trait>Pyromaniac</trait>
        <degree>0</degree>
        <seedSeverity>8</seedSeverity>
      </li>
    </modExtensions>
    <comps>
      <li Class="Psyche.HediffCompProperties_PsycheOffset" />
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>kindling</label>
      </li>
      <li>
        <minSeverity>3</minSeverity>
      </li>
      <li>
        <minSeverity>6</minSeverity>
        <label>raging</label>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Psyche_Scar_Psychopath</defName>
    <hediffClass>Psyche.Hediff_PsycheScar</hediffClass>
    <label>psychopathy psyche scar</label>
    <description>A disconnection from others that runs to the core. It shields this person from grief, but the same wall holds everyone at arm's length, weakening the bonds they can form.</description>
    <isBad>true</isBad>
    <maxSeverity>1000</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <modExtensions>
      <li Class="Psyche.PsycheHealthOffsetExtension">
        <maxHealthPerSeverity>-0.3</maxHealthPerSeverity>
      </li>
      <li Class="Psyche.PsycheTraitMarkExtension">
        <trait>Psychopath</trait>
        <degree>0</degree>
        <seedSeverity>8</seedSeverity>
      </li>
    </modExtensions>
    <comps>
      <li Class="Psyche.HediffCompProperties_PsycheOffset" />
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statOffsets>
          <SocialImpact>-0.30</SocialImpact>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>Psyche_Scar_Bloodlust</defName>
    <hediffClass>Psyche.Hediff_PsycheScar</hediffClass>
    <label>bloodlust psyche scar</label>
    <description>A hunger for violence carved into the psyche. It is a lasting mark, and only the most advanced therapy can lift it entirely.</description>
    <isBad>true</isBad>
    <maxSeverity>1000</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <modExtensions>
      <li Class="Psyche.PsycheHealthOffsetExtension">
        <maxHealthPerSeverity>-0.3</maxHealthPerSeverity>
      </li>
      <li Class="Psyche.PsycheTraitMarkExtension">
        <trait>Bloodlust</trait>
        <degree>0</degree>
        <seedSeverity>8</seedSeverity>
      </li>
    </modExtensions>
    <comps>
      <li Class="Psyche.HediffCompProperties_PsycheOffset" />
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>Psyche_Scar_ChemicalFascination</defName>
    <hediffClass>Psyche.Hediff_PsycheScar</hediffClass>
    <label>chemical fascination psyche scar</label>
    <description>A pull toward chemical escape that the mind keeps returning to. It is a lasting mark, and only the most advanced therapy can lift it entirely.</description>
    <isBad>true</isBad>
    <maxSeverity>1000</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <modExtensions>
      <li Class="Psyche.PsycheHealthOffsetExtension">
        <maxHealthPerSeverity>-0.3</maxHealthPerSeverity>
      </li>
      <li Class="Psyche.PsycheTraitMarkExtension">
        <trait>DrugDesire</trait>
        <degree>2</degree>
        <seedSeverity>8</seedSeverity>
      </li>
    </modExtensions>
    <comps>
      <li Class="Psyche.HediffCompProperties_PsycheOffset" />
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>Psyche_Clarity_Sanguine</defName>
    <hediffClass>Psyche.Hediff_PsycheClarity</hediffClass>
    <label>sanguine psyche clarity</label>
    <description>An innate, level buoyancy of spirit. This person holds more psyche health than their nature alone would allow.</description>
    <isBad>false</isBad>
    <maxSeverity>1000</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <modExtensions>
      <li Class="Psyche.PsycheHealthOffsetExtension">
        <maxHealthPerSeverity>0.3</maxHealthPerSeverity>
      </li>
      <li Class="Psyche.PsycheTraitMarkExtension">
        <trait>NaturalMood</trait>
        <degree>2</degree>
        <seedSeverity>8</seedSeverity>
      </li>
    </modExtensions>
    <comps>
      <li Class="Psyche.HediffCompProperties_PsycheOffset" />
    </comps>
  </HediffDef>

</Defs>
