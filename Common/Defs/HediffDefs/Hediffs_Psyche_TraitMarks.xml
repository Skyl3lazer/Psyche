<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- First-party only. Third-party trait marks ship as compat patches under Patches/Compat. -->

  <HediffDef>
    <defName>Psyche_Scar_Wimp</defName>
    <hediffClass>Psyche.Hediff_PsycheScar</hediffClass>
    <label>wimp psyche scar</label>
    <description>A collapse under pain worn into the mind. It is a lasting mark on the psyche, and only the most advanced therapy can lift it entirely.</description>
    <isBad>true</isBad>
    <maxSeverity>1000</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <modExtensions>
      <li Class="Psyche.PsycheHealthOffsetExtension">
        <maxHealthPerSeverity>-0.3</maxHealthPerSeverity>
      </li>
      <li Class="Psyche.PsycheTraitMarkExtension">
        <trait>Wimp</trait>
        <degree>0</degree>
        <seedSeverity>8</seedSeverity>
      </li>
    </modExtensions>
    <comps>
      <li Class="Psyche.HediffCompProperties_PsycheOffset" />
    </comps>
  </HediffDef>

