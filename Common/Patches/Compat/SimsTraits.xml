          <description>A pattern of gaslighting and love-bombing worn into the mind. It is a lasting mark on the psyche, and only the most advanced therapy can lift it entirely.</description>
          <isBad>true</isBad>
          <maxSeverity>1000</maxSeverity>
          <scenarioCanAdd>false</scenarioCanAdd>
          <modExtensions>
            <li Class="Psyche.PsycheHealthOffsetExtension">
              <maxHealthPerSeverity>-0.3</maxHealthPerSeverity>
            </li>
            <li Class="Psyche.PsycheTraitMarkExtension">
              <trait>ST_Manipulative</trait>
              <degree>0</degree>
              <seedSeverity>8</seedSeverity>
            </li>
