<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>The Sims Traits</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>/Defs</xpath>
      <value>

        <HediffDef>
          <defName>Psyche_Scar_Manipulative</defName>
          <hediffClass>Psyche.Hediff_PsycheScar</hediffClass>
          <label>manipulativeness psyche scar</label>
          <description>Gaslighting and love-bombing have become this person's way of bending others. Only the most advanced therapy can lift it entirely.</description>
          <isBad>true</isBad>
          <maxSeverity>1000</maxSeverity>
          <scenarioCanAdd>false</scenarioCanAdd>
          <modExtensions>
            <li Class="Psyche.PsycheHealthOffsetExtension">
              <maxHealthPerSeverity>-0.3</maxHealthPerSeverity>
            </li>
            <li Class="Psyche.PsycheTraitMarkExtension">
              <trait>ST_Manipulative</trait>
              <degree>0</degree>
              <seedSeverity>8</seedSeverity>
            </li>
          </modExtensions>
          <comps>
            <li Class="Psyche.HediffCompProperties_PsycheOffset" />
          </comps>
        </HediffDef>

